{
  "name": "sistema-club-bochas",
  "version": "1.0.0",
  "description": "Sistema de Gestión Club de Bochas",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Ignacio Gatti",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.clubbochas.app",
    "productName": "Club Bochas Manager",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "libs/**/*",
      "FOTO.PNG",
      "icono.ico",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Club Bochas Manager",
      "deleteAppDataOnUninstall": false
    }
  }
}
